# Modelo dos Secrets da calculadora.
# Streamlit Cloud: copie o conteúdo para Settings › Secrets do app (sem este comentário, se preferir).
# Codespace: copie para .streamlit/secrets.toml (este arquivo NÃO vai para o GitHub).

ADM_SENHA = "troque-por-uma-senha-nova"

[github]
# Token "fine-grained" com permissão Contents: Read and write SÓ no repositório da calculadora
token = "github_pat_..."
repo = "JehFreitas/CalculadoraMinimal"
branch = "main"
path = "config.json"

[sharepoint]
# Preenchido pelo TI depois de registrar o aplicativo no Microsoft Entra ID
tenant_id = ""
client_id = ""
client_secret = ""
site_hostname = "minimaldesign.sharepoint.com"
site_path = "/sites/Comercial"
file_path = "Simulacoes/Simulacoes.xlsx"
table_name = "Simulacoes"
