# Modelo dos Secrets da Calculadora Comercial 2026.
# Streamlit Cloud: cole o conteúdo em Settings › Secrets do app, com os valores reais.
# Codespace: copie para .streamlit/secrets.toml nesta pasta (o arquivo NÃO vai para o GitHub).
# Blocos vazios podem ficar como estão: a calculadora funciona e oferece downloads de reserva.

ADM_SENHA = "troque-por-uma-senha-nova"

[cnpja]
# Token da API comercial da CNPJá (conta contratada). Com ele, a consulta pelo CNPJ
# também traz a inscrição estadual e marca contribuinte / não contribuinte.
token = ""

[github]
# Token "fine-grained" com permissão Contents: Read and write SÓ no repositório da calculadora
token = ""
repo = "JehFreitas/CalculadoraMinimal"
branch = "nova-calculadora-2026"
pasta = "calculadora-2026"

[microsoft]
# Aplicativo registrado pelo TI no Microsoft Entra ID (planilha e e-mail)
tenant_id = ""
client_id = ""
client_secret = ""

[sharepoint]
# Planilha no OneDrive da Jessyca (admincandall-my.sharepoint.com/personal/jessyca_freitas_minimaldesign_com_br1)
drive_id = "b!9LisMABURkOnLfxt8S8T-lX7Ihow9JVJtxQ5ajskt9H_dYDgFm_WQ6NqQn6n3SXh"
# Caminho da planilha dentro do OneDrive
file_path = "Comercial/Controle de Simulações - Calculadora Comercial.xlsx"
tabela_nfe = "Simulacoes"
tabela_va = "VendaAssistida"

[email]
remetente = "calculadora@minimaldesign.com.br"
destinatarios = ["adm.comercial@minimaldesign.com.br"]
